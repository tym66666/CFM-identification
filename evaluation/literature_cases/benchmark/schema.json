{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Literature case benchmark attempt",
  "type": "object",
  "required": [
    "case_id",
    "variant",
    "run_id",
    "model",
    "prompt_version",
    "transport_complete",
    "contract_passed",
    "query_count",
    "semantic_passed",
    "expected_decision_passed"
  ],
  "properties": {
    "case_id": {"type": "string"},
    "variant": {"enum": ["original", "missing_condition", "changed_target"]},
    "run_id": {"type": "string"},
    "model": {"type": "string"},
    "prompt_version": {"type": "string"},
    "transport_complete": {"type": "boolean"},
    "contract_passed": {"type": "boolean"},
    "query_count": {"type": "integer", "minimum": 0},
    "semantic_passed": {"type": ["boolean", "null"]},
    "expected_decision_passed": {"type": ["boolean", "null"]},
    "point_present": {"type": ["boolean", "null"]},
    "point_replay_passed": {"type": ["boolean", "null"]},
    "status": {"type": ["string", "null"]},
    "latency_seconds": {"type": ["number", "null"], "minimum": 0},
    "tokens": {"type": ["integer", "null"], "minimum": 0},
    "cost_usd": {"type": ["number", "null"], "minimum": 0},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
