  },
  "paper_reference": {
    "paper_question": "在组内存在干扰、组间假定无干扰的两阶段随机化试验中，如何定义并识别直接、间接、总效应和总体效应？",
    "target": "间接效应 CE^I(phi,psi) = Ybar(0;phi) - Ybar(0;psi): 本人不处理时，高覆盖率策略与低覆盖率策略下的平均结果之差。",
    "source_location": "Hudgens & Halloran (2008), §3.3 (indirect effect), §3.1 (individual average potential outcome), §4.1 (two-stage estimators), §5.2 and Table 2 (vaccine example).",
    "formula": "Ybar_ij(z;psi) = sum_{omega in R_{n_i-1}} Y_ij(z_i(j)=omega, z_ij=z) Pr_psi(Z_i(j)=omega | Z_ij=z). Indirect effect: CE^I(phi,psi)=Ybar(0;phi)-Ybar(0;psi).",
    "conditions": [
      "Partial interference: interference within groups is allowed; interference between groups is assumed absent.",
      "Two-stage randomization: first assign group-level coverage strategies, then sample individual treatment lists uniformly within groups.",
      "Known assignment strategies phi/psi and known second-stage sampling probabilities.",
      "Consistency: observed outcome equals the potential outcome under the actual complete assignment.",
      "Finite conditional first moments.",
      "First-stage exclusion: the quota profile itself has no direct effect on the outcome given the final assignment.",
      "Positivity for the exposure conditions used by the target."
    ],
    "what_paper_supports": [
      "Defines individual average potential outcomes and indirect effects under partial interference.",
      "Provides unbiased estimators under the two-stage mixed assignment design.",
      "The vaccine example compares 30% vs 50% coverage and reports indirect/total/overall effects.",
      "No interference between groups is an assumption, not a graph fact."
    ],
    "what_paper_does_not_support": [
      "It does not identify the effects if groups interfere with each other.",
      "It does not make the 8-person synthetic case a replication of the paper's data.",
      "It does not support treating the indirect effect as a direct or overall effect.",
      "It does not automatically implement the paper's variance estimators in the current software."
    ]
  },
  "available_information_a4": {
    "population": "All 8 residents: 甲1-甲4, 乙1-乙4, equal weight 1/8.",
    "network": "Fixed pre-treatment network: complete graph within each group, no cross-group edges, 12 undirected edges.",
    "assignment": "Two-stage quota mixture: profiles [1,3] and [3,1] each with probability 1/2; within-group uniform sampling conditional on the profile.",
    "exposure": "S_i = exact number of vaccinated neighbors in the same group; values 1 and 3 are used by the target.",
    "information": "Symbolic population conditional infection probabilities for an unvaccinated person with exactly 1 or exactly 3 vaccinated neighbors; no finite-sample proportions."
  },
  "scientific_assumptions_a5": {
    "status": "PROPOSED_AND_REQUIRES_INDEPENDENT_REVIEW",
    "items": [
      "No interference between groups; within-group interference is allowed.",
      "Full randomization independence.",
      "Consistency.",
      "Finite conditional first moments.",
      "First-stage quota profile has no direct effect given the final assignment.",
      "Positivity for the target exposure conditions."
    ],
    "not_adopted": [
      "No assumption that the 8-person synthetic data are the paper's data.",
      "No assumption that a graph without cross-group edges automatically proves no cross-group interference.",
      "No assumption that indirect effect equals direct or overall effect."
    ]
  },
